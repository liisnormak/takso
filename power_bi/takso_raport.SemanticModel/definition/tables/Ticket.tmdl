	partition Ticket = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "postgres"),
				    public_fact_tickets = Source{[Schema="public",Item="fact_tickets"]}[Data],
				    #"Renamed Columns" = Table.RenameColumns(public_fact_tickets,{{"ticket_id_new", "Ticket ID"}, {"order_id_new", "Order ID"}, {"order_key", "Order Key"}, {"overpaid_ride_ticket", "Overpaid Ride Ticket"}}),
				    #"Reordered Columns" = Table.ReorderColumns(#"Renamed Columns",{"Order Key", "Ticket ID", "Order ID", "Overpaid Ride Ticket", "public.dim_order"})
				in
				    #"Reordered Columns"

	changedProperty = Name

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

